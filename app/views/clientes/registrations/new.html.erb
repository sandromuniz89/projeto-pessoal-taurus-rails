<div style="max-width: 480px; margin: 3rem auto; background: #1e293b; border: 1px solid #334155; border-radius: 16px; padding: 2.2rem; color: #fff; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);">
  
  <div style="text-align: center; margin-bottom: 2rem;">
    <h1 style="margin: 0; font-size: 1.8rem; font-weight: 800; color: #38bdf8;">Criar sua Conta</h1>
    <p style="color: #94a3b8; margin: 0.4rem 0 0 0; font-size: 0.95rem;">Preencha seus dados para começar suas compras</p>
  </div>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "clientes/shared/error_messages", resource: resource %>

    <div style="margin-bottom: 1.2rem;">
      <%= f.label :nome, "Nome Completo", style: "display: block; margin-bottom: 0.4rem; font-weight: 600; color: #cbd5e1; font-size: 0.9rem;" %>
      <%= f.text_field :nome, autofocus: true, placeholder: "Seu nome", style: "width: 100%; padding: 0.75rem; background: #0f172a; border: 1px solid #334155; color: #fff; border-radius: 8px; box-sizing: border-box; font-size: 0.95rem;" %>
    </div>

    <div style="margin-bottom: 1.2rem;">
      <%= f.label :telefone, "WhatsApp / Telefone", style: "display: block; margin-bottom: 0.4rem; font-weight: 600; color: #cbd5e1; font-size: 0.9rem;" %>
      <%= f.telephone_field :telefone, placeholder: "(21) 99999-9999", style: "width: 100%; padding: 0.75rem; background: #0f172a; border: 1px solid #334155; color: #fff; border-radius: 8px; box-sizing: border-box; font-size: 0.95rem;" %>
    </div>

    <div style="margin-bottom: 1.2rem;">
      <%= f.label :email, "E-mail", style: "display: block; margin-bottom: 0.4rem; font-weight: 600; color: #cbd5e1; font-size: 0.9rem;" %>
      <%= f.email_field :email, autocomplete: "email", placeholder: "seu@email.com", required: true, style: "width: 100%; padding: 0.75rem; background: #0f172a; border: 1px solid #334155; color: #fff; border-radius: 8px; box-sizing: border-box; font-size: 0.95rem;" %>
    </div>

    <div style="margin-bottom: 1.2rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
        <%= f.label :password, "Senha", style: "font-weight: 600; color: #cbd5e1; font-size: 0.9rem;" %>
        <% if @minimum_password_length %>
          <small style="color: #94a3b8; font-size: 0.8rem;">(mínimo <%= @minimum_password_length %> caracteres)</small>
        <% end %>
      </div>
      <%= f.password_field :password, autocomplete: "new-password", placeholder: "••••••••", required: true, style: "width: 100%; padding: 0.75rem; background: #0f172a; border: 1px solid #334155; color: #fff; border-radius: 8px; box-sizing: border-box; font-size: 0.95rem;" %>
    </div>

    <div style="margin-bottom: 1.8rem;">
      <%= f.label :password_confirmation, "Confirmar Senha", style: "display: block; margin-bottom: 0.4rem; font-weight: 600; color: #cbd5e1; font-size: 0.9rem;" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••", required: true, style: "width: 100%; padding: 0.75rem; background: #0f172a; border: 1px solid #334155; color: #fff; border-radius: 8px; box-sizing: border-box; font-size: 0.95rem;" %>
    </div>

    <%= f.submit "Cadastrar e Continuar", style: "width: 100%; background: #2563eb; color: #fff; padding: 0.85rem; border: none; border-radius: 8px; font-weight: 700; font-size: 1rem; cursor: pointer; transition: background 0.2s;" %>
  <% end %>

  <div style="text-align: center; margin-top: 1.5rem; padding-top: 1.2rem; border-top: 1px solid #334155; font-size: 0.9rem; color: #94a3b8;">
    Já possui uma conta? 
    <%= link_to "Entrar", new_cliente_session_path, style: "color: #38bdf8; text-decoration: none; font-weight: 600;" %>
  </div>
</div>