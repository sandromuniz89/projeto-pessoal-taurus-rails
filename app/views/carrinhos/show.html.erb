<div style="max-width: 900px; margin: 2rem auto; background: #1e293b; border: 1px solid #334155; border-radius: 16px; padding: 2rem; color: #fff; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.2);">
  
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; border-bottom: 1px solid #334155; padding-bottom: 1rem;">
    <h1 style="margin: 0; font-size: 1.8rem; font-weight: 800; color: #38bdf8;">🛒 Meu Carrinho</h1>
    <%= link_to "← Continuar Comprando", produtos_path, style: "color: #94a3b8; text-decoration: none; font-size: 0.9rem;" %>
  </div>

  <% if notice.present? %>
    <p style="color: #34d399; background: rgba(52, 211, 153, 0.1); padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-weight: 600; border: 1px solid rgba(52, 211, 153, 0.2);"><%= notice %></p>
  <% end %>

  <% if alert.present? %>
    <p style="color: #f87171; background: rgba(248, 113, 113, 0.1); padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-weight: 600; border: 1px solid rgba(248, 113, 113, 0.2);"><%= alert %></p>
  <% end %>

  <% if @itens.empty? %>
    <div style="text-align: center; padding: 3rem 1rem;">
      <p style="font-size: 3rem; margin: 0;">🛍️</p>
      <h3 style="color: #cbd5e1; margin: 0.5rem 0;">Seu carrinho está vazio</h3>
      <p style="color: #94a3b8; margin-bottom: 1.5rem;">Adicione planos ou produtos para finalizar sua compra.</p>
      <%= link_to "Ver Catálogo", produtos_path, style: "background: #2563eb; color: #fff; padding: 0.7rem 1.4rem; border-radius: 8px; text-decoration: none; font-weight: 700;" %>
    </div>
  <% else %>
    <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem;">
      <% @itens.each do |item| %>
        <div style="display: flex; justify-content: space-between; align-items: center; background: #0f172a; padding: 1rem 1.5rem; border-radius: 12px; border: 1px solid #334155;">
          <div style="display: flex; align-items: center; gap: 1.2rem;">
            <div style="width: 60px; height: 60px; background: #1e293b; border-radius: 8px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
              <% if item.produto.imagem.attached? %>
                <%= image_tag item.produto.imagem, style: "width: 100%; height: 100%; object-fit: cover;" %>
              <% else %>
                📦
              <% end %>
            </div>
            <div>
              <h3 style="margin: 0; font-size: 1.05rem; font-weight: 700; color: #fff;"><%= item.produto.nome %></h3>
              <small style="color: #94a3b8;"><%= number_to_currency(item.produto.preco, unit: "R$ ", separator: ",", delimiter: ".") %> cada</small>
            </div>
          </div>

          <div style="display: flex; align-items: center; gap: 2rem;">
            <span style="background: #1e293b; padding: 0.3rem 0.8rem; border-radius: 6px; font-weight: 600; color: #cbd5e1; border: 1px solid #334155;">
              Qtd: <%= item.quantidade %>
            </span>
            <strong style="color: #38bdf8; font-size: 1.15rem; min-width: 90px; text-align: right;">
              <%= number_to_currency(item.subtotal, unit: "R$ ", separator: ",", delimiter: ".") %>
            </strong>
            <%= button_to "✕", item_carrinho_path(item), method: :delete, style: "background: none; border: none; color: #ef4444; font-size: 1.1rem; cursor: pointer; padding: 0.2rem 0.5rem;" %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Resumo e Botão de Checkout -->
    <div style="background: #0f172a; border-radius: 12px; padding: 1.5rem; border: 1px solid #334155; display: flex; justify-content: space-between; align-items: center;">
      <div>
        <span style="color: #94a3b8; font-size: 0.95rem; display: block;">Valor Total:</span>
        <strong style="color: #fff; font-size: 1.8rem;"><%= number_to_currency(@carrinho.total, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
        <small style="display: block; color: #10b981; font-weight: 600; margin-top: 0.2rem;">⚡ Chave PIX gerada no próximo passo</small>
      </div>

      <div>
        <%= button_to "Finalizar Pedido via PIX →", pedidos_path, method: :post, style: "background: #10b981; color: #fff; border: none; padding: 0.9rem 2rem; border-radius: 8px; font-size: 1.05rem; font-weight: 800; cursor: pointer; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);" %>
      </div>
    </div>
  <% end %>
</div>